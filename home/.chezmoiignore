# ---- デスクトップ(CachyOS)専用。サーバー等には配置しない ----

# デスクトップUI・日本語入力・テーマ
.gtkrc-2.0
.config/hypr/**
.config/waybar/**
.config/wofi/**
.config/swaync/**
.config/fcitx5/**
.config/gtk-3.0/**
.config/gtk-4.0/**
.config/wezterm/**
.config/environment.d/**

# SSH設定は1Passwordエージェント前提のためワークステーション専用
.ssh/**

# 1Password(op)で秘密を取得するためワークステーション専用
