#!/usr/bin/env bash
# claude-rc: run `claude remote-control` in a background zellij session.
#
#   claude-rc [-d] [name] [dir]
#     -d    start only; do not attach
#     name  zellij session name (default: basename of dir)
#     dir   working directory   (default: current directory)
#
#   CLAUDE_RC_MODE  permission mode for spawned sessions (default: auto)
#
# Starts the session if it is not running, then attaches when run from a terminal.
# Without a terminal (or with -d) it only starts it. Detach from zellij and the
# server keeps running; `claude-rc <name>` reattaches. Does not survive a reboot.
set -euo pipefail

# Non-interactive shells may lack these (claude: ~/.local/bin, zellij: mise)
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

detach=false
if [ "${1:-}" = "-d" ]; then
  detach=true
  shift
fi

for cmd in zellij claude; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "claude-rc: $cmd not found" >&2
    exit 1
  fi
done

dir="$(cd "${2:-.}" && pwd)"
name="${1:-$(basename "$dir")}"
mode="${CLAUDE_RC_MODE:-auto}"

# running / exited / "" (none). Exited sessions are still listed by zellij.
# (list-sessions exits non-zero when there are no sessions at all)
state="$(zellij list-sessions --no-formatting 2>/dev/null |
  awk -v n="$name" '$1 == n { print (/EXITED/ ? "exited" : "running") }' || true)"

if [ "$state" = running ]; then
  echo "claude-rc: session '$name' is already running"
else
  if [ "$state" = exited ]; then
    zellij delete-session "$name" >/dev/null
  fi
  # The session inherits the current directory
  cd "$dir"
  zellij attach --create-background "$name" -- \
    claude remote-control --name "$(hostname -s)-$name" --permission-mode "$mode"
  echo "claude-rc: started session '$name' in $dir"
fi

if ! $detach && [ -t 0 ] && [ -t 1 ]; then
  exec zellij attach "$name"
fi
