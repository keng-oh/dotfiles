    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "通知センター",
      "clear-all-button": true,
      "button-text": "すべて消去"
    },
    "dnd": {
      "text": "通知を無効化"
    }
  }
