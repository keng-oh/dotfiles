[core]
	editor = nvim

[gpg]
	format = openpgp

[gpg "openpgp"]
	program = gpg

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[init]
	defaultBranch = main

[user]
	email = contact@ken-g.dev
	name = KENG

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm = histogram

[rerere]
	enabled = true

[branch]
	sort = -committerdate

{{ if eq .chezmoi.osRelease.id "cachyos" -}}
[interactive]
	diffFilter = delta --color-only

[pager]
	blame = delta
	diff = delta
	log = delta
	show = delta

{{ end -}}
