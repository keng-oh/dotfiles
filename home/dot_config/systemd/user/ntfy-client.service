[Unit]
Description=ntfy: スマホ通知を購読してデスクトップ通知を表示
Documentation=https://docs.ntfy.sh/subscribe/cli/
After=network-online.target
Wants=network-online.target
AssertPathExists=%h/.config/ntfy/client.yml

[Service]
ExecStart=/usr/bin/ntfy subscribe --from-config
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
